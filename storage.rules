rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.uid == "NoGsCqiKc0VJwWb6rppk7QVLV1B2" ||
        request.auth.token.admin == true
      );
    }

    function isOwnProfileImage(fileName) {
      return signedIn() &&
        fileName.matches('^' + request.auth.uid + '_.*$');
    }

    function isSafeImageUpload(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes &&
        request.resource.contentType.matches('image/.*');
    }

    match /produtos/{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() && isSafeImageUpload(10 * 1024 * 1024);
    }

    match /galeria/{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin() && isSafeImageUpload(10 * 1024 * 1024);
    }

    // Fotos de perfil: abrir pela URL continua livre, mas listar a pasta
    // (descobrir fotos/UIDs de clientes) fica restrito ao admin.
    match /profile_images/{fileName} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if (isAdmin() || isOwnProfileImage(fileName)) && isSafeImageUpload(5 * 1024 * 1024);
    }

    // Pasta legada criada para um "outro site" que nao existe mais.
    // Auditoria 2026-11-03: estava vazia e aceitava upload ANONIMO de ate 20 MB.
    // Leitura mantida; escrita fechada.
    match /legacy-open/{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    match /{allPaths=**} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }
  }
}
